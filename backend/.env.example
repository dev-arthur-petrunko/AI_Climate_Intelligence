# =============================================================================
# Climate Intelligence — Backend environment (example / documentation)
# Copy to .env and fill in your values.
# =============================================================================

# --- Data sources ------------------------------------------------------------
# NASA FIRMS API key for live wildfire hotspots.
# Free registration: https://firms.modaps.eosdis.nasa.gov/ (email signup).
# Without this key the API returns simulated hotspot data.
FIRMS_API_KEY=

# NASA API key for NeoWs (asteroids), DONKI (space weather) and other services.
# Free registration: https://api.nasa.gov (instant email key).
# Without this key the API returns empty fallback data.
NASA_API_KEY=

# --- Database (Render + Neon) -------------------------------------------------
# Postgres connection string from Neon (Dashboard -> Connection details -> SQL).
# Example: postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/climate?sslmode=require
DATABASE_URL=

# Pool / connection tuning (optional)
DATABASE_POOL_SIZE=5

# --- AI (Groq) ----------------------------------------------------------------
# Groq API key for AI climate analysis and predictions.
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=
# Optional: Groq model to use for AI analysis/predictions
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Air Quality (OpenAQ) ----------------------------------------------------
# OpenAQ v3 API key for global air quality measurements.
# Free registration: https://explore.openaq.org/register
# Without this key the endpoint returns Open-Meteo fallback data.
OPENAQ_API_KEY=

# --- Deployment ---------------------------------------------------------------
# CORS allowed origins, comma-separated.
# Local default covers Next.js dev server; on Render set to your Vercel URL,
# e.g. CORS_ORIGINS=https://your-app.vercel.app
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server port (Render sets $PORT automatically; optional locally)
# PORT=8000
