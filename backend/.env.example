# =============================================================================
# Climate Intelligence — Backend environment (example / documentation)
# Copy to .env and fill in your values.
# =============================================================================

# --- Data sources ------------------------------------------------------------
# NASA FIRMS API key for live wildfire hotspots.
# Free registration: https://firms.modaps.eosdis.nasa.gov/ (email signup).
# Without this key the API returns simulated hotspot data.
FIRMS_API_KEY=

# --- Database (Render + Neon) -------------------------------------------------
# Postgres connection string from Neon (Dashboard -> Connection details -> SQL).
# Example: postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/climate?sslmode=require
DATABASE_URL=

# Pool / connection tuning (optional)
DATABASE_POOL_SIZE=5
